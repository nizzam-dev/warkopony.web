// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ini nanti untuk table ygy:>, iyh gt ajh, nanti jlnin "npx prisma validate" lalu "npx prisma migrate dev --name init"
// npx prisma generate

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  bookingCode   String            @unique @map("booking_code") @db.VarChar(32)
  name          String            @db.VarChar(150)
  phone         String            @db.VarChar(30)
  reservationAt DateTime          @map("reservation_at") @db.Timestamptz(3)
  guestCount    Int               @map("guest_count")
  status        ReservationStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, reservationAt])
  @@map("reservations")
}

enum Role {
  ADMIN
  KASIR
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(KASIR)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
